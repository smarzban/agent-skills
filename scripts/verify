#!/usr/bin/env bash
# The one command that says whether this checkout is good. CI runs this same file.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

step() { printf '\n== %s\n' "$*"; "$@"; }

step skills/_shared/scripts/check-skills
step shellcheck -x bin/skills .githooks/* scripts/verify scripts/worktree-setup \
  skills/_shared/scripts/check-skills skills/handoff/scripts/handoff-status \
  skills/repo-setup/scripts/lines-kept skills/repo-setup/scripts/repo-audit
