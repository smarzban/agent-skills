#!/usr/bin/env bash
# Prepare a fresh git worktree: private notes, local env files.
# Run it from inside the new worktree. It never overwrites a file that exists.
set -euo pipefail

# Ignored files that git does not carry into a new worktree. Edit this list for the repo.
LOCAL="AGENTS.local.md"

here="$(git rev-parse --show-toplevel)"
main="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
cd "$here"

# Copied, not linked: Claude Code does not load an imported file that is a link to outside the folder.
if [ "$here" != "$main" ]; then
  for f in $LOCAL; do
    if [ -f "$main/$f" ] && [ ! -e "$f" ]; then cp "$main/$f" "$f"; echo "copied  $f"; fi
  done
fi
for f in $LOCAL; do
  if [ ! -e "$f" ] && [ -f "$f.example" ]; then cp "$f.example" "$f"; echo "created $f from $f.example"; fi
done

echo "worktree ready: $here"
