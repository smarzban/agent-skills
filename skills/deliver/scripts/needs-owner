#!/usr/bin/env python3
"""List the changed paths that the repo's owner must approve before a merge.

usage: needs-owner [--base REF]

The list is read from the "## Needs the owner" section of AGENTS.md as it is on the
base branch, never from the working tree, so that a change cannot remove itself
from the list. One path per bullet, in backticks; a folder ends with "/", and * and
? are wildcards.

Always on the list, whatever AGENTS.md says:
  CI configuration   .github/workflows/, .gitlab-ci.yml, .circleci/, .buildkite/, azure-pipelines.yml
  the list itself    a change to the "Needs the owner" section of AGENTS.md
  CODEOWNERS

  --base   the branch the change will merge into. Default: origin/HEAD, origin/main,
           main or master, whichever exists first.

Output: NEEDS-OWNER <path>  (<rule>) for each match, then a summary line.
Exit status: 0 nothing needs the owner, 1 at least one path does, 2 usage or repo error.
"""
import fnmatch
import re
import subprocess
import sys

BUILTIN = [".github/workflows/", ".gitlab-ci.yml", ".circleci/", ".buildkite/", "azure-pipelines.yml",
           "CODEOWNERS", ".github/CODEOWNERS", "docs/CODEOWNERS"]


def git(*args):
    r = subprocess.run(["git"] + list(args), capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else None


def covers(pattern, path):
    if pattern.endswith("/"):
        return path.startswith(pattern)
    return path == pattern or fnmatch.fnmatchcase(path, pattern)


def section(text):
    out, inside = [], False
    for line in (text or "").splitlines():
        if line.startswith("## "):
            inside = line[3:].strip().lower() == "needs the owner"
            continue
        if inside and line.strip():
            out.append(line.strip())
    return out


def main(argv):
    base = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a == "--base":
            i += 1
            if i >= len(argv):
                print("needs-owner: --base needs a branch", file=sys.stderr)
                return 2
            base = argv[i]
        else:
            print("needs-owner: unknown argument %s" % a, file=sys.stderr)
            return 2
        i += 1

    if git("rev-parse", "--git-dir") is None:
        print("needs-owner: not inside a git repository", file=sys.stderr)
        return 2
    if base is None:
        for cand in ("origin/HEAD", "origin/main", "main", "master"):
            if git("rev-parse", "-q", "--verify", cand + "^{commit}"):
                base = cand
                break
    if base is None or not git("rev-parse", "-q", "--verify", base + "^{commit}"):
        print("needs-owner: no base branch found; pass --base", file=sys.stderr)
        return 2
    mb = (git("merge-base", base, "HEAD") or "").strip()
    if not mb:
        print("needs-owner: no merge base with %s" % base, file=sys.stderr)
        return 2

    changed = []
    for out in (git("diff", "--name-only", mb, "HEAD"), git("diff", "--name-only", "HEAD"),
                git("ls-files", "--others", "--exclude-standard")):
        for p in (out or "").splitlines():
            if p and p not in changed:
                changed.append(p)

    base_list = section(git("show", "%s:AGENTS.md" % base))
    listed = [p for line in base_list for p in re.findall(r"`([^`\s]+)`", line)]

    hits = []
    for c in changed:
        rule = next((p for p in listed if covers(p, c)), None)
        if rule:
            hits.append((c, "AGENTS.md on %s lists %s" % (base, rule)))
            continue
        rule = next((p for p in BUILTIN if covers(p, c)), None)
        if rule:
            hits.append((c, "always: %s" % rule))
    if "AGENTS.md" in changed:
        try:
            with open(git("rev-parse", "--show-toplevel").strip() + "/AGENTS.md", encoding="utf-8") as f:
                now = section(f.read())
        except OSError:
            now = []
        if now != base_list:
            hits.append(("AGENTS.md", "always: the Needs the owner list changed"))

    for path, rule in hits:
        print("NEEDS-OWNER %s  (%s)" % (path, rule))
    print("needs-owner: %d changed path(s), %d need the owner; list on %s has %d path(s)"
          % (len(changed), len(hits), base, len(listed)))
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
