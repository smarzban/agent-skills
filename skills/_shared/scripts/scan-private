#!/usr/bin/env python3
"""Find content that should not become public: secrets and private references.

usage: scan-private [--history] [--allow-host HOST]... [PATH...]

With PATH arguments it scans those files and folders. With none it scans every
file tracked by git in the current repo. --history also scans every commit on
every ref: added lines, commit messages, and author names and emails.

Categories:
  secret   key, token and password shapes (the value is masked in the output)
  path     absolute home-folder paths
  email    email addresses
  host     private-looking hosts and addresses, tracker and wiki links
  ticket   ticket ids such as ABC-123
  author   distinct commit authors (--history only, listed for review)

A hit is a candidate, not a verdict: read each one. The pattern list is short,
so run a dedicated secret scanner (gitleaks, trufflehog) as well when one is
installed. --allow-host drops hosts that are meant to be public.

Exit status: 0 nothing found, 1 findings, 2 usage error.
"""
import os
import re
import subprocess
import sys

SECRET = [
    ("private key", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("AWS access key", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("GitHub token", re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,})\b")),
    ("Slack token", re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}\b")),
    ("API key", re.compile(r"\b(?:sk|pk|rk)[-_](?:live|test|proj|ant)?[-_]?[A-Za-z0-9_-]{20,}\b")),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
    ("JWT", re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{5,}\b")),
    ("credentials in URL", re.compile(r"[a-z][a-z0-9+.-]*://[^/\s:@]+:[^/\s:@]+@")),
    ("assigned secret", re.compile(
        r"(?i)\b[\w.-]*(?:password|passwd|secret|token|api[_-]?key|access[_-]?key)[\w.-]*\s*[:=]\s*[\"']?([^\s\"'<>${}]{8,})")),
]
PLACEHOLDER = re.compile(r"(?i)^(?:x+|\*+|\.+|your[\w-]*|example[\w-]*|changeme|change-me|placeholder|redacted|dummy|test\w*|none|null|true|false|process\.env\.\w+|os\.environ\w*|env\.\w+)$")
HOME = re.compile(r"(?:/Users/|/home/|[A-Z]:\\Users\\)[A-Za-z0-9._-]+")
EMAIL = re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+\b")
PUBLIC_MAIL = re.compile(r"(?i)@(?:example\.(?:com|org|net)|users\.noreply\.github\.com|noreply\.\w+)$|^(?:git|noreply|no-reply)@")
URL_HOST = re.compile(r"https?://([A-Za-z0-9.-]+)")
PRIVATE_HOST = re.compile(
    r"(?i)(?:\.(?:internal|corp|local|lan|intranet|home\.arpa)$|^(?:10|192\.168|172\.(?:1[6-9]|2\d|3[01]))\.\d|"
    r"atlassian\.net$|\.slack\.com$|linear\.app$|notion\.so$|^(?:jira|confluence|wiki|gitlab|grafana|jenkins|vault|sentry)\.)")
BARE_PRIVATE = re.compile(r"\b[a-z0-9-]+(?:\.[a-z0-9-]+)*\.(?:internal|corp|intranet)\b|\b(?:10|192\.168|172\.(?:1[6-9]|2\d|3[01]))(?:\.\d{1,3}){2,3}\b")
TICKET = re.compile(r"\b[A-Z][A-Z0-9]{1,9}-\d{1,6}\b")
NOT_TICKET = re.compile(r"^(?:UTF|ISO|SHA|MD|RFC|CVE|HTTP|TLS|SSL|ES|X|V|PEP|AES|RSA|UTC|GPT|ARM|AMD|WIN|CP|EC|ED|BCP|IEEE|COVID|PY|H|MP|GB|US|EN)-")
SKIP_DIRS = {".git", "node_modules", "target", "dist", "build", ".venv", "venv", "__pycache__", ".astro"}
BINARY = re.compile(r"\.(?:png|jpe?g|gif|ico|webp|pdf|zip|gz|tgz|woff2?|ttf|otf|mp4|mov|wasm|so|dylib|bin|lock)$", re.I)


def mask(v):
    return v[:4] + "…" + ("*" * 6) if len(v) > 8 else "*" * len(v)


def scan_text(where, text, allow, out):
    for no, line in enumerate(text.splitlines(), 1):
        if len(line) > 2000:
            line = line[:2000]
        loc = "%s:%d" % (where, no)
        for name, rx in SECRET:
            m = rx.search(line)
            if not m:
                continue
            val = m.group(1) if rx.groups else m.group(0)
            if name == "assigned secret" and (PLACEHOLDER.match(val) or not re.search(r"\d|[A-Z].*[a-z]|[a-z].*[A-Z]", val)):
                continue
            out.append(("secret", loc, "%s: %s" % (name, mask(val))))
            break
        m = HOME.search(line)
        if m:
            out.append(("path", loc, m.group(0)))
        for m in EMAIL.finditer(line):
            if not PUBLIC_MAIL.search(m.group(0)):
                out.append(("email", loc, m.group(0)))
        hosts = set(URL_HOST.findall(line))
        for h in hosts:
            if h.lower() not in allow and PRIVATE_HOST.search(h):
                out.append(("host", loc, h))
        for m in BARE_PRIVATE.finditer(line):
            if m.group(0) not in hosts and m.group(0).lower() not in allow:
                out.append(("host", loc, m.group(0)))
        for m in TICKET.finditer(line):
            if not NOT_TICKET.match(m.group(0)):
                out.append(("ticket", loc, m.group(0)))


def git(args, cwd=None):
    r = subprocess.run(["git"] + args, capture_output=True, cwd=cwd)
    if r.returncode != 0:
        return None
    return r.stdout.decode("utf-8", "replace")


def files_under(path):
    if os.path.isfile(path):
        yield path
        return
    for dp, dn, fn in os.walk(path):
        dn[:] = sorted(d for d in dn if d not in SKIP_DIRS)
        for f in sorted(fn):
            yield os.path.join(dp, f)


def main(argv):
    history = False
    allow = set()
    paths = []
    args = list(argv)
    while args:
        a = args.pop(0)
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a == "--history":
            history = True
        elif a == "--allow-host":
            if not args:
                print("scan-private: --allow-host needs a host", file=sys.stderr)
                return 2
            allow.add(args.pop(0).lower())
        elif a.startswith("-"):
            print("scan-private: unknown option %s" % a, file=sys.stderr)
            return 2
        else:
            paths.append(a)

    out = []
    files = []
    if paths:
        for p in paths:
            if not os.path.exists(p):
                print("scan-private: no such file or folder: %s" % p, file=sys.stderr)
                return 2
            files.extend(files_under(p))
    else:
        listed = git(["ls-files", "-z"])
        if listed is None:
            print("scan-private: not inside a git repository; pass the paths to scan", file=sys.stderr)
            return 2
        files = [f for f in listed.split("\0") if f]
    for f in files:
        if BINARY.search(f) or not os.path.isfile(f):
            continue
        try:
            with open(f, encoding="utf-8", errors="replace") as fh:
                scan_text(f, fh.read(), allow, out)
        except OSError:
            continue

    commits = 0
    if history:
        log = git(["log", "--all", "--no-color", "-p", "--unified=0", "--no-ext-diff",
                   "--format=%x01%h%x02%an%x02%ae%x02%B%x03"])
        if log is None:
            print("scan-private: --history needs a git repository", file=sys.stderr)
            return 2
        authors = {}
        for chunk in log.split("\x01")[1:]:
            commits += 1
            head, _, patch = chunk.partition("\x03")
            sha, an, ae, body = (head.split("\x02", 3) + ["", "", ""])[:4]
            authors.setdefault("%s <%s>" % (an, ae), sha)
            scan_text("commit %s message" % sha, body, allow, out)
            fname = "?"
            added = []
            for line in patch.splitlines():
                if line.startswith("+++ "):
                    if added:
                        scan_text("commit %s %s" % (sha, fname), "\n".join(added), allow, out)
                        added = []
                    fname = line[6:] if line.startswith("+++ b/") else line[4:]
                elif line.startswith("+") and not BINARY.search(fname):
                    added.append(line[1:])
            if added:
                scan_text("commit %s %s" % (sha, fname), "\n".join(added), allow, out)
        for who, sha in sorted(authors.items()):
            out.append(("author", "first seen %s" % sha, who))

    seen = set()
    counts = {}
    for cat, loc, what in out:
        key = (cat, what) if cat in ("author",) else (cat, loc, what)
        if key in seen:
            continue
        seen.add(key)
        counts[cat] = counts.get(cat, 0) + 1
        print("%-7s %s  %s" % (cat, loc, what))
    total = sum(n for cat, n in counts.items() if cat != "author")   # authors are listed for review, not counted
    scope = "%d file(s)" % len(files) + (", %d commit(s)" % commits if history else "")
    detail = ", ".join("%s %d" % kv for kv in sorted(counts.items())) or "nothing found"
    print("scan-private: %s scanned: %s" % (scope, detail))
    return 1 if total else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
