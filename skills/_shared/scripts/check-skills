#!/usr/bin/env bash
# Check every skill under a skills folder: frontmatter, referenced files, links into _shared, scripts.
# usage: check-skills [SKILLS_DIR]     (default: the folder that holds _shared)
set -uo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  d="$(cd -P "$(dirname "$self")" && pwd)"; self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$d/$self" ;; esac
done
root="${1:-$(cd -P "$(dirname "$self")/../.." && pwd)}"
[ -d "$root" ] || { echo "check-skills: no such folder: $root" >&2; exit 2; }
root="$(cd -P "$root" && pwd)"
shared="$root/_shared"
fail=0
bad() { printf 'FAIL %s\n' "$*"; fail=$((fail + 1)); }

# Frontmatter is parsed as YAML by Ruby's standard library. Prints one problem per line, then "chars N".
command -v ruby >/dev/null 2>&1 || { echo "check-skills: needs ruby on PATH to parse frontmatter as YAML" >&2; exit 2; }
# shellcheck disable=SC2016
yaml_check='require "yaml"
begin
  h = YAML.safe_load($stdin.read)
rescue Exception => e
  puts "frontmatter is not valid YAML: #{e.message.lines.first.to_s.strip}"; puts "chars 0"; exit
end
unless h.is_a?(Hash)
  puts "frontmatter is not a mapping of keys"; puts "chars 0"; exit
end
puts "frontmatter name is #{h["name"].inspect}" unless h["name"] == ARGV[0]
d = h["description"]
puts "no description" unless d.is_a?(String) && !d.strip.empty?
extra = h.keys - %w[name description disable-model-invocation]
puts "unexpected frontmatter key: #{extra.join(", ")}" unless extra.empty?
puts "chars #{d.is_a?(String) ? d.length : 0}"'

for skill in "$root"/*/; do
  skill="${skill%/}"; name="$(basename "$skill")"
  [ -f "$skill/SKILL.md" ] || continue
  md="$skill/SKILL.md"

  # Frontmatter: between a first-line --- and a closing ---, valid YAML, a mapping whose name matches
  # the folder, with a description and no other keys.
  chars=0
  if [ "$(sed -n '1p' "$md")" != "---" ]; then bad "$name: SKILL.md does not start with ---"
  elif ! awk 'NR>1 && /^---$/{found=1; exit} END{exit !found}' "$md"; then bad "$name: frontmatter has no closing ---"
  elif out="$(awk 'NR==1{next} /^---$/{exit} {print}' "$md" | ruby -e "$yaml_check" "$name")"; then
    while IFS= read -r line; do
      case "$line" in "chars "*) chars="${line#chars }" ;; *) bad "$name: $line" ;; esac
    done <<< "$out"
  else bad "$name: could not parse the frontmatter"
  fi

  # Every reference/, scripts/ or templates/ path named in a Markdown file of the skill exists.
  find "$skill" -name '*.md' | while IFS= read -r doc; do
    # shellcheck disable=SC2016 # the backticks are literal Markdown, not a command
    grep -oE '`(reference|scripts|templates)/[A-Za-z0-9._/-]+`' "$doc" 2>/dev/null | tr -d '`' | sort -u | while IFS= read -r ref; do
      # scripts/<x> may name a file that the skill creates in the target repo from templates/<x>.
      [ -e "$skill/$ref" ] || [ -e "$skill/templates/$(basename "$ref")" ] || echo "FAIL $name: ${doc#"$root"/} names $ref, which does not exist"
    done
  done > "${TMPDIR:-/tmp}/check-skills.$$"
  if [ -s "${TMPDIR:-/tmp}/check-skills.$$" ]; then cat "${TMPDIR:-/tmp}/check-skills.$$"; fail=$((fail + $(wc -l < "${TMPDIR:-/tmp}/check-skills.$$"))); fi
  rm -f "${TMPDIR:-/tmp}/check-skills.$$"

  # Links resolve and stay inside the skills folder. A plain copy of a shared file must match it.
  while IFS= read -r f; do
    if [ -L "$f" ]; then
      target="$(cd -P "$(dirname "$f")" 2>/dev/null && cd -P "$(dirname "$(readlink "$f")")" 2>/dev/null && pwd)/$(basename "$(readlink "$f")")"
      if [ ! -e "$f" ]; then bad "$name: broken link ${f#"$root"/} -> $(readlink "$f")"
      else case "$target" in "$root"/*) ;; *) bad "$name: ${f#"$root"/} points outside the skills folder" ;; esac; fi
    elif [ -d "$shared" ]; then
      twin="$(find "$shared" -type f -name "$(basename "$f")" | head -1)"
      if [ -n "$twin" ] && ! cmp -s "$f" "$twin"; then bad "$name: ${f#"$root"/} is a copy that differs from ${twin#"$root"/}"; fi
    fi
  done < <(find "$skill" \( -type f -o -type l \) ! -name SKILL.md)

  # Scripts are executable and parse.
  for dir in "$skill/scripts" "$skill/templates"; do
    [ -d "$dir" ] || continue
    for s in "$dir"/*; do
      [ -f "$s" ] || continue
      [ -x "$s" ] || bad "$name: ${s#"$root"/} is not executable"
      case "$(sed -n '1p' "$s")" in
        *python*) python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$s" 2>/dev/null || bad "$name: ${s#"$root"/} does not parse" ;;
        *sh*)     bash -n "$s" 2>/dev/null || bad "$name: ${s#"$root"/} does not parse" ;;
        *)        bad "$name: ${s#"$root"/} has no interpreter line" ;;
      esac
    done
  done
  printf 'ok   %-20s description %s chars, SKILL.md %s bytes\n' "$name" "$chars" "$(wc -c < "$md" | tr -d ' ')"
done

if [ "$fail" -gt 0 ]; then echo "check-skills: $fail problem(s)"; exit 1; fi
echo "check-skills: no problems"
