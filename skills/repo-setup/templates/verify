#!/usr/bin/env bash
# The one command that says whether this checkout is good. CI runs this same file.
# repo-setup writes one line per real check, taken from CI config and package scripts.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

step() { printf '\n== %s\n' "$*"; "$@"; }

